# managed by ansible (infra/ansible/roles/observability). root only: holds
# the probe tenant's otlp token and machine api key (platformctl
# probe-tenant create) and the gatus push token.
PROBER_OPS_ADDR=0.0.0.0:9090
PROBER_INTERVAL={{ observability_probe_interval }}
PROBER_TIMEOUT={{ observability_probe_timeout }}
PROBER_FRESHNESS_MAX_DELAY={{ observability_probe_freshness_max_delay }}
PROBER_CERT_MIN_VALIDITY={{ observability_probe_cert_min_validity }}
PROBER_INGEST_URL=https://{{ sa_hostnames.in }}
PROBER_OTLP_URL=https://{{ sa_hostnames.otlp }}
PROBER_CONSOLE_URL=https://{{ sa_hostnames.app }}/
PROBER_WEB_URL=https://{{ sa_hostnames.web }}/api/heartbeat
PROBER_MACHINE_API_URL=https://{{ sa_hostnames.app }}/api/metrics/v1
PROBER_MACHINE_API_KEY={{ sa_secrets.probe_machine_api_key }}
PROBER_SITE_ID={{ sa_secrets.probe_site_id }}
PROBER_SITE_ORIGIN=https://{{ observability_probe_domain }}
PROBER_USER_AGENT={{ observability_probe_user_agent }}
PROBER_OTLP_TOKEN={{ sa_secrets.probe_otlp_token }}
PROBER_TRACKER_MANIFEST=/releases/manifest.json
PROBER_NODES={{ observability_probe_nodes | map(attribute='spec') | join(';') }}
PROBER_GATUS_URL=http://gatus:8080
PROBER_GATUS_TOKEN={{ sa_secrets.gatus_external_token }}
{% if observability_probe_ca_file is defined %}
PROBER_CA_FILE=/etc/prober/ca.crt
{% endif %}
