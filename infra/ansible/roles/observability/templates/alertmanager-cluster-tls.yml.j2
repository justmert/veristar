# managed by ansible (infra/ansible/roles/observability). mutual tls of the
# alertmanager cluster's gossip (--cluster.tls-config, experimental in
# alertmanager 0.34.2). with it the members exchange gossip
# over tls connections only; the plain udp gossip of memberlist is not used.
# each side presents its node certificate and checks the other's against
# the internal ca and the peer address.
tls_server_config:
  cert_file: /etc/sa-tls/node.crt
  key_file: /etc/sa-tls/node.key
  client_ca_file: /etc/sa-tls/ca.crt
  client_auth_type: RequireAndVerifyClientCert
  min_version: TLS13
tls_client_config:
  cert_file: /etc/sa-tls/node.crt
  key_file: /etc/sa-tls/node.key
  ca_file: /etc/sa-tls/ca.crt
