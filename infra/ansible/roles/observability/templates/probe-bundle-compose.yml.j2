# generated by infra/ansible/playbooks/probe-bundle.yml for {{ sa_environment }};
# edit the template, not this file (docs/deploy/probe.md).
#
# the outside view of the platform on a shared host outside the platform's
# own hosting: the prober sends a real web event and otlp metric every
# {{ observability_probe_interval }}, reads them back, checks every node's tls and pushes each
# result to gatus. gatus is the public status page on {{ sa_hostnames.status }}.
# no container publishes a port: the host's one edge caddy owns 80 and 443
# and reaches gatus (and, for prometheus, the prober) over the external
# docker network "{{ probe_bundle_edge_network }}", with the site file
# {{ probe_bundle_site_file }} of this bundle.
#
#   docker compose up -d
name: {{ probe_bundle_project }}

x-defaults: &defaults
  restart: unless-stopped
  read_only: true
  # the writable /tmp of a read-only container. gatus's sqlite needs a
  # temporary directory once a query spills to a temporary file; without
  # one the statuses api answers "disk I/O error (6410)" (SQLITE_IOERR_GETTEMPPATH).
  # mode 1777 because docker on the probe host mounts it 0755 root otherwise,
  # which gatus (uid 8080) cannot write either
  tmpfs: ["/tmp:size=64m,mode=1777"]
  security_opt: ["no-new-privileges:true"]
  cap_drop: [ALL]
  logging:
    driver: local
    options:
      max-size: 20m
      max-file: "5"
  environment:
    TZ: UTC

services:
  gatus:
    <<: *defaults
    image: {{ observability_images.gatus }}
    # a fixed name: the edge caddy proxies to it by name, and other projects
    # on the shared network must not be able to shadow a generic "gatus"
    container_name: {{ probe_bundle_project }}-gatus
    user: "{{ observability_gatus_uid }}:{{ observability_gatus_uid }}"
    env_file: [gatus.env]
    environment:
      TZ: UTC
      GATUS_CONFIG_PATH: /config/config.yaml
    volumes:
      - ./gatus.yml:/config/config.yaml:ro
      # a directory the host owner hands to the gatus uid once
      # (docs/deploy/probe.md); gatus's image has no shell to do it itself
      - ./gatus-data:/data
    networks: [default, edge]
    mem_limit: 256m

  prober:
    <<: *defaults
    image: {{ observability_images.prober }}
    container_name: {{ probe_bundle_project }}-prober
    depends_on: [gatus]
    env_file: [prober.env]
    volumes:
      - ./releases:/releases:ro
    # on the edge network only so the edge caddy can serve its metrics to
    # prometheus behind the bearer token of the site file
    networks: [default, edge]
    mem_limit: 128m

  # copies each ended day of the slo results out of gatus into ./slo-data
  # (cmd/sloreport watch); gatus keeps only about a week of raw results, so
  # the monthly report (docs/runbooks/slo-report.md) is made from these files.
  # it reads the public status page, the same source a by-hand collect uses,
  # so the files name that source
  sloreport:
    <<: *defaults
    image: {{ probe_bundle_sloreport_base }}
    container_name: {{ probe_bundle_project }}-sloreport
    depends_on: [gatus]
    user: "{{ probe_bundle_uid }}:{{ probe_bundle_uid }}"
    entrypoint: ["/sloreport"]
    command: ["watch", "-gatus", "https://{{ sa_hostnames.status }}", "-out", "/data", "-page-size", "{{ observability_gatus_max_results }}"]
    volumes:
      - ./bin/sloreport:/sloreport:ro
      - ./slo-data:/data
    networks: [default]
    mem_limit: 256m

networks:
  default: {}
  edge:
    external: true
    name: {{ probe_bundle_edge_network }}
