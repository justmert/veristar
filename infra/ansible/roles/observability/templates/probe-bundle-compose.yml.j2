# generated by infra/ansible/playbooks/probe-bundle.yml for {{ sa_environment }};
# edit the template, not this file (docs/deploy/probe.md).
#
# the outside view of the platform on a host outside azure, for example a
# probe host that already runs an uptime monitor: the prober sends a real web
# event and otlp metric every {{ observability_probe_interval }}, reads them back, checks every
# node's tls and pushes each result to gatus. gatus keeps the history and
# answers the per-check status api that an uptime monitor's json query checks
# read. nothing listens publicly: gatus is published on PROBE_BIND only.
#
#   PROBE_BIND=172.17.0.1 docker compose up -d
name: veristar-probe-{{ sa_environment }}

x-defaults: &defaults
  restart: unless-stopped
  read_only: true
  security_opt: ["no-new-privileges:true"]
  cap_drop: [ALL]
  logging:
    driver: local
    options:
      max-size: 20m
      max-file: "5"
  environment:
    TZ: UTC

services:
  gatus:
    <<: *defaults
    image: {{ observability_images.gatus }}
    user: "{{ observability_gatus_uid }}:{{ observability_gatus_uid }}"
    env_file: [gatus.env]
    environment:
      TZ: UTC
      GATUS_CONFIG_PATH: /config/config.yaml
    volumes:
      - ./gatus.yml:/config/config.yaml:ro
      - gatus:/data
    ports:
      # the uptime monitor reads http://<PROBE_BIND>:{{ probe_bundle_port }}/api/v1/endpoints/<key>/statuses
      - "${PROBE_BIND:?set PROBE_BIND to the address the uptime monitor reaches}:{{ probe_bundle_port }}:8080"

  prober:
    <<: *defaults
    image: {{ observability_images.prober }}
    depends_on: [gatus]
    env_file: [prober.env]
    volumes:
      - ./releases:/releases:ro

volumes:
  gatus:
