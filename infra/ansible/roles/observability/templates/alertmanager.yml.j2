# managed by ansible (infra/ansible/roles/observability). both core nodes run
# one member of the cluster (--cluster.peer); either prometheus reaches
# both, and the members share silences and notification state, so an alert
# is sent once.
route:
  receiver: {{ 'discord' if observability_alertmanager_receiver else 'none' }}
  group_by: [alertname, node, stream_name, check]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # the dead-man signal (rules/platform.yml Watchdog): pushed to the
    # probe's gatus every minute; gatus alerts when it stops arriving
    - matchers: [alertname="Watchdog"]
      receiver: heartbeat
      group_by: [alertname]
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m

receivers:
{% if observability_alertmanager_receiver %}
  - name: discord
    discord_configs:
      # an operator input. the url is a secret, read from a root-only file
      - webhook_url_file: /etc/alertmanager/discord-webhook-url
        send_resolved: true
        title: '{% raw %}{{ if eq .Status "firing" }}FIRING{{ else }}RESOLVED{{ end }} {{ .CommonLabels.alertname }}{% endraw %} ({{ sa_environment }})'
        message: '{% raw %}{{ range .Alerts }}{{ .Annotations.summary }} ({{ .Annotations.runbook }}){{ "\n" }}{{ end }}{% endraw %}'
{% else %}
  # no webhook an operator input unset): alerts are evaluated and listed in
  # alertmanager and grafana, and sent nowhere (docs/runbooks/alerts.md)
  - name: none
{% endif %}

{% if groups['probe'] | default([]) | length > 0 %}
  # gatus external endpoint "monitoring watchdog" (templates/gatus.yml.j2);
  # gatus ignores the body and takes the result from the query
  - name: heartbeat
    webhook_configs:
      - url: "https://{{ sa_hostnames.status }}/api/v1/endpoints/monitoring_watchdog/external?success=true"
        send_resolved: false
        http_config:
          authorization:
            credentials_file: /etc/alertmanager/gatus-external-token
{% if observability_probe_ca_file is defined %}
          tls_config: {ca_file: /etc/alertmanager/probe-ca.crt}
{% endif %}
{% else %}
  # no probe node yet an operator input: nothing outside the core tier can watch
  # the watchdog, so it goes nowhere rather than to discord every minute
  - name: heartbeat
{% endif %}

# a node that is down raises its own alert; the per-check alerts of the
# same node add nothing until it is back
inhibit_rules:
  - source_matchers: [alertname="EdgeNodeNotReady"]
    target_matchers: [alertname="VisitorSecretMissing"]
    equal: [node]
  - source_matchers: [alertname="NATSQuorumLost"]
    target_matchers: [alertname=~"VisitorSecretMissing|EdgeNodeNotReady"]
