# generated by infra/ansible/playbooks/probe-bundle.yml for {{ sa_environment }};
# edit the template, not this file (docs/deploy/probe.md).
#
# veristar's public status page ({{ probe_bundle_project }}) on a shared edge caddy: the
# one site file this project adds under the edge's sites/. the edge caddy
# gets the certificate and reaches the containers by name over the shared
# docker network. same routes as templates/probe.Caddyfile.j2 of a
# dedicated probe node.
{{ sa_hostnames.status }} {
	encode zstd gzip

	# gatus sends no security headers of its own. its page has one inline
	# script (window.config, rendered from gatus.yml's ui block) and one
	# inline style (ui custom-css); the script is allowed by its hash, which
	# the bundle playbook takes from probe_bundle_csp_script_hashes
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "default-src 'none'; script-src 'self'{% for h in probe_bundle_csp_script_hashes %} '{{ h }}'{% endfor %}; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	request_body {
		max_size 64KB
	}

{% include 'probe-brand.caddy.j2' %}

{% if probe_bundle_metrics %}
	# the prober's and gatus's metrics for prometheus on the core nodes
	# (templates/prometheus.yml.j2), behind the probe metrics token
	@metrics_ok {
		path /internal/prober/metrics /internal/gatus/metrics
		header Authorization "Bearer {{ sa_secrets.probe_metrics_token }}"
	}
	handle @metrics_ok {
		@prober path /internal/prober/metrics
		handle @prober {
			rewrite * /metrics
			reverse_proxy {{ probe_bundle_project }}-prober:9090
		}
		handle {
			rewrite * /metrics
			reverse_proxy {{ probe_bundle_project }}-gatus:8080
		}
	}
{% endif %}
	handle /internal/* {
		respond "not found" 404
	}
{% if probe_bundle_watchdog %}
	# the watchdog push of alertmanager on the core nodes (rules Watchdog);
	# gatus checks its bearer token, caddy only lets the core nodes reach it
	@watchdog {
		path /api/v1/endpoints/monitoring_watchdog/external
		remote_ip {{ groups['core'] | map('extract', hostvars, 'sa_public_ipv4') | join(' ') }}
	}
	handle @watchdog {
		reverse_proxy {{ probe_bundle_project }}-gatus:8080
	}
{% endif %}
	# every other push comes from the prober on the compose network, never
	# from outside
	handle /api/v1/endpoints/*/external {
		respond "not found" 404
	}
	handle /metrics {
		respond "not found" 404
	}
	handle {
		reverse_proxy {{ probe_bundle_project }}-gatus:8080
	}
}
