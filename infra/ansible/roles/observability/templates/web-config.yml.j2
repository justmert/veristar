# managed by ansible (infra/ansible/roles/observability). the exporter
# toolkit's web config of node_exporter, postgres_exporter and alertmanager:
# https with the node certificate, and a client certificate of the internal
# ca required, so only prometheus (and an operator holding
# the operators' certificate) can read them
tls_server_config:
  cert_file: /etc/sa-tls/node.crt
  key_file: /etc/sa-tls/node.key
  client_ca_file: /etc/sa-tls/ca.crt
  client_auth_type: RequireAndVerifyClientCert
  min_version: TLS13
