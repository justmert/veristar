# managed by ansible (infra/ansible/roles/secrets) from the sops file. root only.
NATS_USER=controlplane
NATS_PASSWORD={{ sa_secrets.nats_passwords.controlplane }}
{% if not (core_oauth_fixture | default(false)) %}
GITHUB_CLIENT_ID={{ sa_secrets.github_client_id }}
GITHUB_CLIENT_SECRET={{ sa_secrets.github_client_secret }}
{% else %}
# the test-only oauth fixture's registered client (local converge only)
GITHUB_CLIENT_ID=local-converge-fixture-client
GITHUB_CLIENT_SECRET=local-converge-fixture-secret
{% endif %}
OAUTH_STATE_KEY={{ sa_secrets.oauth_state_key }}
REPORT_SIGNING_SEED={{ sa_secrets.report_signing_seed }}
REPORT_SIGNING_KEY={{ sa_secrets.report_signing_key }}
UMAMI_ADMIN_PASSWORD={{ sa_secrets.umami_admin_password }}
UMAMI_USER_PASSWORD_KEY={{ sa_secrets.umami_user_password_key }}
PLATFORM_DB_CP_SYSTEM_PASSWORD={{ sa_secrets.platform_db_cp_system_password }}
PLATFORM_DB_CP_TENANT_PASSWORD={{ sa_secrets.platform_db_cp_tenant_password }}
PLATFORM_DB_CP_OPERATOR_PASSWORD={{ sa_secrets.platform_db_cp_operator_password }}
