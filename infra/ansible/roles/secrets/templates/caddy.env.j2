# managed by ansible (infra/ansible/roles/secrets) from the sops file. root only.
{% if sa_tls in ['cloudflare', 'cloudflare-delegated'] %}
CLOUDFLARE_API_TOKEN={{ sa_secrets.cloudflare_api_token }}
{% endif %}
{% if sa_tls == 'cloudflare-delegated' %}
ACME_CHALLENGE_DOMAIN={{ sa_acme_challenge_domain }}
{% endif %}
