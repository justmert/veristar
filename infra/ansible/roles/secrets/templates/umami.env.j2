# managed by ansible (infra/ansible/roles/secrets) from the sops file. root only.
# tls to postgresql through haproxy, checked against the internal ca and the
# name "haproxy". umami reads the database with node-postgres,
# which takes libpq's sslmode verify-full and sslrootcert. its migrations
# run prisma's schema engine, whose url parser knows only disable, prefer
# and require and quietly reads any other sslmode as prefer, so the engine
# gets its own url: require (tls or nothing), the ca as sslcert, and
# sslaccept=strict, which checks the chain and the host name.
DATABASE_URL=postgresql://umami_app:{{ sa_secrets.umami_db_password }}@haproxy:5000/umami?sslmode=verify-full&sslrootcert=/etc/sa-tls/ca.crt
DIRECT_DATABASE_URL=postgresql://umami_app:{{ sa_secrets.umami_db_password }}@haproxy:5000/umami?sslmode=require&sslcert=/etc/sa-tls/ca.crt&sslaccept=strict
APP_SECRET={{ sa_secrets.umami_app_secret }}
