# managed by ansible (infra/ansible/roles/secrets) from the sops file. root only.
# bootstrap only: migrations run as the postgres superuser through haproxy
NATS_USER=platformctl
NATS_PASSWORD={{ sa_secrets.nats_passwords.platformctl }}
PLATFORM_DB_ADMIN_USER=postgres
PLATFORM_DB_ADMIN_PASSWORD={{ sa_secrets.postgres_superuser_password }}
PLATFORM_DB_CP_SYSTEM_PASSWORD={{ sa_secrets.platform_db_cp_system_password }}
PLATFORM_DB_CP_TENANT_PASSWORD={{ sa_secrets.platform_db_cp_tenant_password }}
PLATFORM_DB_CP_OPERATOR_PASSWORD={{ sa_secrets.platform_db_cp_operator_password }}
PLATFORM_DB_METRICS_WRITER_PASSWORD={{ sa_secrets.platform_db_metrics_writer_password }}
PLATFORM_DB_JOBS_PASSWORD={{ sa_secrets.platform_db_jobs_password }}
UMAMI_ADMIN_PASSWORD={{ sa_secrets.umami_admin_password }}
UMAMI_DB_JOBS_RETENTION_PASSWORD={{ sa_secrets.umami_db_jobs_retention_password }}
