# managed by ansible (infra/ansible/roles/edge). edge tier of the design
# 4.1: caddy, gateway, collector, one nats server and one etcd member. on a
# converged node (sa_tier node) the core project's caddy serves the edge
# sites too and joins this project's network, so this one has no caddy.
# private ports bind to the private address only; caddy alone binds the
# public one. secrets come from the root-only env files of the secrets role.
name: veristar-edge

x-defaults: &defaults
  restart: unless-stopped
  # the certificate installed by the secrets role; a new certificate or ca
  # bundle changes the label and so recreates every container reading them
  labels:
    sa.tls: "{{ secrets_tls_fingerprint }}"
  # container hardening (the design): the root filesystem is read-only, so
  # services write only to their volumes and a small /tmp; no capabilities;
  # no privilege gain through setuid binaries or file capabilities
  read_only: true
  cap_drop: [ALL]
  security_opt: ["no-new-privileges:true"]
  tmpfs: ["/tmp:size=64m"]
  logging:
    driver: local
    options:
      max-size: 20m
      max-file: "5"

services:
  # nats and etcd default to root in their upstream images and run as their
  # own uids here. docker creates a new named volume owned by root, and a
  # volume from before this change holds root-owned files, so this one-shot
  # step hands both volumes over before either starts. children before
  # parents (-depth), and only what is not owned yet, so it is quick and
  # can be repeated.
  volume-owners:
    <<: *defaults
    image: {{ upstream_images.nats }}
    restart: "no"
    user: "0:0"
    cap_add: [CHOWN, DAC_READ_SEARCH]
    entrypoint: ["/bin/sh", "-ec"]
    command:
      - |
        for spec in "/v/nats {{ edge_nats_uid }}" "/v/etcd {{ edge_etcd_uid }}"; do
          set -- $$spec
          find "$$1" -depth \( ! -user "$$2" -o ! -group "$$2" \) -exec chown -h "$$2:$$2" {} +
        done
    volumes:
      - natsdata:/v/nats
      - etcddata:/v/etcd

  nats:
    <<: *defaults
    image: {{ upstream_images.nats }}
    user: "{{ edge_nats_uid }}:{{ edge_nats_uid }}"
    depends_on:
      volume-owners:
        condition: service_completed_successfully
    command: ["--config", "/etc/nats/nats.conf"]
    volumes:
      - {{ edge_conf_dir }}/nats:/etc/nats:ro
      - {{ sa_tls_dir }}/nats:/etc/nats-tls:ro
      - natsdata:/data
    # clients (tls) and routes (mutual tls) on the private address;
    # monitoring on loopback only, the relay serves it over tls
    ports:
      - "{{ sa_private_ip }}:4222:4222"
      - "{{ sa_private_ip }}:6222:6222"
      - "127.0.0.1:8222:8222"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8222/healthz?js-enabled-only=true"]
      interval: 5s
      timeout: 3s
      retries: 12
      start_period: 10s

  etcd:
    <<: *defaults
    image: {{ upstream_images.etcd }}
    user: "{{ edge_etcd_uid }}:{{ edge_etcd_uid }}"
    depends_on:
      volume-owners:
        condition: service_completed_successfully
    # etcd stores patroni's leader key; one member per edge node, peers and
    # clients on the private network. both are mutual
    # tls with the node certificate: a peer or client without a certificate
    # of the internal ca is refused in the handshake, before any request
    #. prometheus reads /metrics the same way.
    command:
      - etcd
      - --name={{ inventory_hostname }}
      - --data-dir=/var/lib/etcd
      - --listen-peer-urls=https://0.0.0.0:2380
      - --listen-client-urls=https://0.0.0.0:2379
      - --initial-advertise-peer-urls=https://{{ sa_private_ip }}:2380
      - --advertise-client-urls=https://{{ sa_private_ip }}:2379
      - --initial-cluster={{ groups['edge'] | zip(groups['edge'] | map('extract', hostvars, 'sa_private_ip')) | map('join', '=https://') | map('regex_replace', '$', ':2380') | join(',') }}
      - --client-cert-auth=true
      - --trusted-ca-file=/etc/etcd/tls/ca.crt
      - --cert-file=/etc/etcd/tls/node.crt
      - --key-file=/etc/etcd/tls/node.key
      - --peer-client-cert-auth=true
      - --peer-trusted-ca-file=/etc/etcd/tls/ca.crt
      - --peer-cert-file=/etc/etcd/tls/node.crt
      - --peer-key-file=/etc/etcd/tls/node.key
      - --tls-min-version=TLS1.3
      - --initial-cluster-token=sa-{{ sa_environment }}
      # new when the cluster is created, existing when a rebuilt node rejoins
      # (tasks/etcd.yml)
      - --initial-cluster-state={{ edge_etcd_initial_state }}
    volumes:
      - etcddata:/var/lib/etcd
      - {{ sa_tls_dir }}/etcd:/etc/etcd/tls:ro
    ports:
      - "{{ sa_private_ip }}:2379:2379"
      - "{{ sa_private_ip }}:2380:2380"
    healthcheck:
      test: ["CMD", "etcdctl", "--endpoints=https://127.0.0.1:2379", "--cacert=/etc/etcd/tls/ca.crt",
             "--cert=/etc/etcd/tls/node.crt", "--key=/etc/etcd/tls/node.key", "endpoint", "health"]
      interval: 5s
      timeout: 3s
      retries: 24
      start_period: 10s

  gateway:
    <<: *defaults
    image: {{ platform_images.gateway }}
    depends_on: [nats]
    env_file: [{{ secrets_env_dir }}/gateway.env]
    volumes:
      - {{ sa_tls_dir }}/ca:/etc/sa-tls:ro
    environment:
      NATS_URL: "{{ edge_nats_urls }}"
      NATS_TLS_CA: /etc/sa-tls/ca.crt
      NATS_REPLICAS: "3"
      GATEWAY_NODE_ID: "{{ inventory_hostname }}"
      GATEWAY_ADDR: 0.0.0.0:8080
      GATEWAY_OPS_ADDR: 0.0.0.0:9090
      CLIENT_IP_HEADER: X-Edge-Client-Ip
      GATEWAY_SECURE_TRANSPORT: "true"
      EDGE_HEALTH_COLLECTOR_URL: http://collector:13133/
      EDGE_HEALTH_NATS_URL: http://nats:8222/healthz
      TZ: UTC
{% for k, v in edge_gateway_env.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}

  collector:
    <<: *defaults
    image: {{ platform_images.collector }}
    depends_on: [nats]
    env_file: [{{ secrets_env_dir }}/collector.env]
    volumes:
      - {{ sa_tls_dir }}/ca:/etc/sa-tls:ro
    environment:
      NATS_URL: "{{ edge_nats_urls }}"
      NATS_TLS_CA: /etc/sa-tls/ca.crt
      COLLECTOR_GRPC_ADDR: 0.0.0.0:4317
      COLLECTOR_HTTP_ADDR: 0.0.0.0:4318
      COLLECTOR_HEALTH_ADDR: 0.0.0.0:13133
      TZ: UTC
{% for k, v in edge_collector_env.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}

{% if not edge_shares_node %}
  caddy:
    <<: *defaults
    image: {{ platform_images.caddy }}
    depends_on: [gateway, collector]
    # both networks: see the public network below
    networks: [default, public]
    env_file: [{{ secrets_env_dir }}/caddy.env]
    environment:
      SA_TLS: {{ sa_tls }}
      BASE_DOMAIN: "{{ sa_base_domain }}"
      GATEWAY_UPSTREAM: gateway:8080
      COLLECTOR_GRPC_UPSTREAM: collector:4317
      COLLECTOR_HTTP_UPSTREAM: collector:4318
      COLLECTOR_HEALTH_UPSTREAM: collector:13133
      NODE_HEALTH_UPSTREAM: gateway:9090
      NODE_HEALTH_PATH: /edgez
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      # deploy.yml's drain flag (deploy/caddy/assemble.sh)
      - {{ edge_drain_dir }}:/drain:ro
      - caddydata:/data
      - caddyconfig:/config
    ports:
      - "{{ sa_public_bind_ipv4 | default(sa_public_ipv4) }}:80:80"
      - "{{ sa_public_bind_ipv4 | default(sa_public_ipv4) }}:443:443"
      - "{{ sa_public_bind_ipv4 | default(sa_public_ipv4) }}:443:443/udp"
{% if sa_public_ipv6 %}
      - "[{{ sa_public_ipv6 }}]:80:80"
      - "[{{ sa_public_ipv6 }}]:443:443"
      - "[{{ sa_public_ipv6 }}]:443:443/udp"
{% endif %}
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2019/config/"]
      interval: 10s
      timeout: 3s
      retries: 6
{% endif %}
{% if not edge_shares_node %}

# review: docker can forward a published ipv6 port into a container only
# through docker-proxy when the container has no ipv6 address, and caddy then
# sees the bridge gateway (one ipv4 address) as the peer of every ipv6
# visitor, so every per-client limit and the visitor token collapse into one
# key. caddy alone also joins this ipv6-only network: docker then dnats ipv6
# straight to it and the real client address survives, while ipv4 still
# arrives through the default network. the other services stay ipv4-only, so
# their names keep resolving to ipv4 addresses (pg_hba, nats, haproxy).
# needs docker 28 or newer (per-family gateway endpoints, enable_ipv4) and
# ip6tables, which the base role's daemon.json keeps on.
# docs/deploy/ansible.md "client addresses over ipv6".
networks:
  public:
    enable_ipv4: false
    enable_ipv6: true
    ipam:
      config:
        - subnet: {{ edge_public6_subnet }}
{% endif %}

volumes:
  natsdata:
  etcddata:
{% if not edge_shares_node %}
  caddydata:
  caddyconfig:
{% endif %}
