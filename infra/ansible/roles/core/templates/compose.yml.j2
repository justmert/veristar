# managed by ansible (infra/ansible/roles/core). core tier of
# docs/architecture.md. only caddy binds the public address; postgresql and
# patroni bind the private one (replication, haproxy on the other core node);
# everything else stays on this project's network. secrets come from the
# root-only env files of the secrets role.
name: veristar-core

x-defaults: &defaults
  restart: unless-stopped
  # the certificate installed by the secrets role; a new certificate or ca
  # bundle changes the label and so recreates every container reading them
  labels:
    sa.tls: "{{ secrets_tls_fingerprint }}"
  # container hardening: the root filesystem is read-only, so
  # services write only to their volumes and a small /tmp (patroni's pgpass,
  # pgbackrest's locks, caddy's temporary truststore); no capabilities; no
  # privilege gain through setuid binaries or file capabilities. every image
  # here already runs as a non-root user (postgres, haproxy, nextjs, caddy's
  # 10001, distroless nonroot)
  read_only: true
  cap_drop: [ALL]
  security_opt: ["no-new-privileges:true"]
  tmpfs: ["/tmp:size=64m"]
  logging:
    driver: local
    options:
      max-size: 20m
      max-file: "5"

x-db: &db
  PLATFORM_DB_HOST: haproxy
  PLATFORM_DB_PORT: "5000"
  PLATFORM_DB_NAME: platform
  # tls to postgresql through haproxy, checked against the internal ca and
  # the name "haproxy"; the server refuses plain text and
  # the services refuse anything but verify-full with a ca configured
  PLATFORM_DB_SSLMODE: verify-full
  PLATFORM_DB_SSLROOTCERT: /etc/sa-tls/ca.crt

x-nats: &nats
  NATS_URL: "{{ core_nats_urls }}"
  NATS_TLS_CA: /etc/sa-tls/ca.crt
  NATS_REPLICAS: "3"

# docker can forward a published ipv6 port into a container only
# through docker-proxy when the container has no ipv6 address, and caddy then
# sees the bridge gateway (one ipv4 address) as the peer of every ipv6
# visitor, so every per-client limit and the visitor token collapse into one
# key. caddy alone also joins this ipv6-only network: docker then dnats ipv6
# straight to it and the real client address survives, while ipv4 still
# arrives through the default network. the other services stay ipv4-only, so
# their names keep resolving to ipv4 addresses (pg_hba, nats, haproxy).
# needs docker 28 or newer (per-family gateway endpoints, enable_ipv4) and
# ip6tables, which the base role's daemon.json keeps on.
# docs/deploy/ansible.md "client addresses over ipv6".
networks:
  default:
    ipam:
      config:
        - subnet: {{ core_compose_subnet }}
  public:
    enable_ipv4: false
    enable_ipv6: true
    ipam:
      config:
        - subnet: {{ core_public6_subnet }}
{% if core_node %}
  # a converged node: this caddy also serves in. and otlp., so it reaches the
  # gateway and the collector on the edge project's network
  edge:
    name: veristar-edge_default
    external: true
{% endif %}

services:
{% if core_runs_postgres %}
  postgres:
    <<: *defaults
    image: {{ platform_images.postgres_ha }}
    # patroni stops postgresql cleanly on sigterm; give it time
    stop_grace_period: 2m
    shm_size: 256m
    environment:
      TZ: UTC
    volumes:
      - {{ core_conf_dir }}/patroni:/etc/patroni:ro
      - {{ sa_tls_dir }}/postgres:/etc/patroni-tls:ro
      - pgdata:/var/lib/postgresql
      # archive_command runs pgbackrest archive-push (roles/backup)
      - {{ backup_conf_dir }}:/etc/pgbackrest:ro
      - pgrun:/var/run/postgresql
    ports:
      - "{{ sa_private_ip }}:5432:5432"
      - "{{ sa_private_ip }}:8008:8008"
    healthcheck:
      # healthy once postgresql runs under patroni, leader or replica
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "--cacert", "/etc/patroni-tls/ca.crt",
             "--cert", "/etc/patroni-tls/node.crt", "--key", "/etc/patroni-tls/node.key", "https://127.0.0.1:8008/health"]
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 30s

{% if backup_repo_mode == 'posix-host' %}
  # the repository node takes backups by reading this node through its own
  # pgbackrest server (local converge only, roles/backup)
  pgbackrest:
    <<: *defaults
    image: {{ platform_images.postgres_ha }}
    # created after postgres: two containers that create the same new
    # volume at once race on copying the image's directory into it
    depends_on: [postgres]
    entrypoint: ["pgbackrest", "server"]
    command: []
    environment:
      TZ: UTC
    volumes:
      - {{ backup_conf_dir }}:/etc/pgbackrest:ro
      - pgdata:/var/lib/postgresql
      - pgrun:/var/run/postgresql
    ports:
      - "{{ sa_private_ip }}:{{ backup_tls_port }}:{{ backup_tls_port }}"
    healthcheck:
      test: ["CMD", "pgbackrest", "server-ping"]
      interval: 10s
      timeout: 5s
      retries: 12

{% endif %}
{% endif %}
  haproxy:
    <<: *defaults
    image: {{ upstream_images.haproxy }}
    volumes:
      - {{ core_conf_dir }}/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro
      - {{ sa_tls_dir }}/haproxy:/etc/haproxy-tls:ro
    # the stats page on loopback only, for an ssh tunnel; prometheus reads
    # /metrics through the observability relay instead
    ports:
      - "127.0.0.1:{{ core_haproxy_stats_port }}:{{ core_haproxy_stats_port }}"
{% if core_runs_postgres %}
    # started, not healthy: haproxy routes to the leader wherever it runs,
    # so it must not wait for this node's member. on 2026-11-14 a replica that
    # needed 25 minutes to catch up after a reboot held haproxy back through
    # sa-core-start.service, and every service of the node that reaches the
    # database through it (umami, jobs, metricswriter, the control plane)
    # stayed down, app. answering 502 from that node
    depends_on:
      postgres:
        condition: service_started
{% endif %}

  # umami process 1 also serves the read and admin api for the control plane
  # and jobs; bootstrap starts it alone, so it runs umami's migrations before
  # any other process exists. no caddy site proxies to umami: it is reachable
  # from the private network only
  umami: &umami
    <<: *defaults
    image: {{ upstream_images.umami }}
    depends_on: [haproxy]
    env_file: [{{ secrets_env_dir }}/umami.env]
    volumes:
      - {{ sa_tls_dir }}/ca:/etc/sa-tls:ro
    # umami's own ui on the node's loopback only, for a platform administrator
    # over an ssh tunnel (ssh -L {{ core_umami_admin_port }}:127.0.0.1:{{ core_umami_admin_port }});
    # tenants and operators read web analytics in the console, and no caddy
    # site proxies to umami
    ports:
      - "127.0.0.1:{{ core_umami_admin_port }}:3000"
    # umami runs on postgresql alone; REDIS_URL, CLICKHOUSE_URL, KAFKA_URL, CLOUD_MODE,
    # MCP_ENABLED, DISABLE_BOT_CHECK and SKIP_LOCATION_HEADERS stay unset
    environment:
      CLIENT_IP_HEADER: x-edge-client-ip
      ENABLE_CLIENT_SALT: "1"
      SALT_ROTATION: daily
      PRIVATE_MODE: "1"
      DISABLE_TELEMETRY: "1"
      DISABLE_UPDATES: "1"
      DISABLE_LOGIN: "1"
      TZ: UTC
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:3000/api/heartbeat"]
      interval: 5s
      timeout: 3s
      retries: 60
      start_period: 120s
{% for i in range(2, (core_umami_processes | int) + 1) %}

  # umami process {{ i }} of {{ core_umami_processes }}: /api/send for the replayer only
  # (core_umami_processes). same image, database and APP_SECRET as process
  # 1, so session and visit ids do not depend on the process
  # (docs/reference/umami-contract.md item 14). started after process 1 is
  # healthy, so it never races it on a migration.
  umami-{{ i }}:
    <<: *umami
    # process 1 alone holds the loopback port of the ui
    ports: []
    depends_on:
      umami:
        condition: service_healthy
{% endfor %}

  controlplane:
    <<: *defaults
    image: {{ platform_images.controlplane }}
    depends_on:
      umami:
        condition: service_healthy
    env_file: [{{ secrets_env_dir }}/controlplane.env]
    volumes:
      - {{ sa_tls_dir }}/ca:/etc/sa-tls:ro
      # this node's certificate, owned by the control plane's user: every
      # alertmanager member asks its clients for one
      - {{ sa_tls_dir }}/controlplane:/etc/sa-alertmanager-tls:ro
    environment:
      <<: [*db, *nats]
      CONTROLPLANE_ADDR: 0.0.0.0:8085
      CONTROLPLANE_OPS_ADDR: 0.0.0.0:9090
      CONSOLE_ORIGIN: https://{{ sa_hostnames.app }}
      INGEST_ORIGIN: https://{{ sa_hostnames.in }}
      GITHUB_REDIRECT_URL: https://{{ sa_hostnames.app }}/api/auth/github/callback
      # the bootstrap of the operator roster: every start makes these
      # identities active operator admins. everyone else is added on the
      # console's operators page
      OPERATOR_GITHUB_IDS: "{{ sa_operator_github_ids }}"
      # stellar accounts of operators who sign in with a wallet; empty when
      # the inventory lists none
      OPERATOR_STELLAR_ADDRESSES: "{{ sa_operator_stellar_addresses | default('') }}"
      # how long a passkey step-up opens the operator area, and how long a
      # first operator passkey may be registered without one (contract 5.15)
      OPERATOR_STEP_UP_MAX_AGE: "{{ sa_operator_step_up_max_age | default('12h') }}"
      OPERATOR_ENROLL_WINDOW: "{{ sa_operator_enroll_window | default('24h') }}"
      # earlier usage report keys whose reports still verify, newest first
      # (docs/runbooks/secret-rotation.md); empty until the first rotation
      REPORT_SIGNING_RETIRED_KEYS: "{{ sa_report_signing_retired_keys | default('') }}"
      UMAMI_URL: http://umami:3000
      API_MINUTE_RETENTION_DAYS: "{{ core_api_minute_retention_days }}"
      API_HOURLY_RETENTION_MONTHS: "{{ core_api_hourly_retention_months }}"
      # the operator alerts page (contract 11) asks every alertmanager member
      # on its private address; prometheus sends each alert to all of them,
      # so the page also names a member that does not answer
      ALERTMANAGER_URLS: "{% for h in groups['core'] %}https://{{ hostvars[h].sa_private_ip }}:{{ core_alertmanager_port }}{{ '' if loop.last else ',' }}{% endfor %}"
      ALERTMANAGER_TLS_CA: /etc/sa-alertmanager-tls/ca.crt
      ALERTMANAGER_TLS_CERT: /etc/sa-alertmanager-tls/node.crt
      ALERTMANAGER_TLS_KEY: /etc/sa-alertmanager-tls/node.key
{% for k, v in core_stellar_env.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
{% if core_oauth_fixture %}
      # local converge only (asserted above): the test-only oauth fixture
      OAUTH_FIXTURE_URL: http://{{ sa_public_ipv4 }}:{{ core_oauth_fixture_port }}
{% endif %}
      TZ: UTC

  replayer:
    <<: *defaults
    image: {{ platform_images.replayer }}
    # on sigterm the replayer delivers what its partitions hold (up to 10 s)
    # before it gives them back, so the next owner starts without waiting
    # out the ack wait of 30 s
    stop_grace_period: 30s
    depends_on:
      umami:
        condition: service_healthy
{% for i in range(2, (core_umami_processes | int) + 1) %}
      umami-{{ i }}:
        condition: service_healthy
{% endfor %}
    env_file: [{{ secrets_env_dir }}/replayer.env]
    volumes:
      - {{ sa_tls_dir }}/ca:/etc/sa-tls:ro
    environment:
      <<: *nats
      REPLAYER_NODE_ID: "{{ inventory_hostname }}"
      REPLAYER_OPS_ADDR: 0.0.0.0:9090
      # every umami process; the replayer sends each visitor's events to one
      # of them, picked by the visitor hash of its lanes
      UMAMI_URL: "http://umami:3000{% for i in range(2, (core_umami_processes | int) + 1) %},http://umami-{{ i }}:3000{% endfor %}"
      TZ: UTC
{% for k, v in core_replayer_env.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}

  metricswriter:
    <<: *defaults
    image: {{ platform_images.metricswriter }}
    depends_on: [haproxy]
    env_file: [{{ secrets_env_dir }}/metricswriter.env]
    volumes:
      - {{ sa_tls_dir }}/ca:/etc/sa-tls:ro
    environment:
      <<: [*db, *nats]
      METRICSWRITER_NODE_ID: "{{ inventory_hostname }}"
      METRICSWRITER_OPS_ADDR: 0.0.0.0:9090
      TZ: UTC
{% for k, v in core_metricswriter_env.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}

  jobs:
    <<: *defaults
    image: {{ platform_images.jobs }}
    command: ["daemon"]
    depends_on:
      umami:
        condition: service_healthy
    env_file: [{{ secrets_env_dir }}/jobs.env]
    volumes:
      - {{ sa_tls_dir }}/ca:/etc/sa-tls:ro
    environment:
      <<: [*db, *nats]
      JOBS_OPS_ADDR: 0.0.0.0:9090
      UMAMI_URL: http://umami:3000
      UMAMI_DB_NAME: umami
      API_MINUTE_RETENTION_DAYS: "{{ core_api_minute_retention_days }}"
      API_HOURLY_RETENTION_MONTHS: "{{ core_api_hourly_retention_months }}"
{% for k, v in core_stellar_env.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
      TZ: UTC

  caddy:
    <<: *defaults
    # the custom caddy build with the console's static files at /srv/console
    image: {{ platform_images.console }}
    depends_on: [controlplane]
    # both networks: see the public network above
    networks: {{ ['default', 'public'] + (['edge'] if core_node else []) }}
    env_file: [{{ secrets_env_dir }}/caddy.env]
    environment:
      SA_TLS: {{ sa_tls }}
      BASE_DOMAIN: "{{ sa_base_domain }}"
      CONTROLPLANE_UPSTREAM: controlplane:8085
      CONSOLE_ROOT: /srv/console
      # caddy carries the ingest hot path on a converged node
      # (docs/reference/gateway-limits.md, "capacity")
      GOGC: "{{ sa_ingest_gogc }}"
      GODEBUG: adaptivestackstart=1
{% if core_node %}
      # port 80: "/" is the edge health (in. and otlp.), "/core" the
      # console's (app.); deploy/caddy/assemble.sh, tier node
      GATEWAY_UPSTREAM: gateway:8080
      COLLECTOR_GRPC_UPSTREAM: collector:4317
      COLLECTOR_HTTP_UPSTREAM: collector:4318
      COLLECTOR_HEALTH_UPSTREAM: collector:13133
      NODE_HEALTH_UPSTREAM: gateway:9090
      NODE_HEALTH_PATH: /edgez
      CORE_HEALTH_UPSTREAM: controlplane:9090
      CORE_HEALTH_PATH: /corez
{% else %}
      NODE_HEALTH_UPSTREAM: controlplane:9090
      NODE_HEALTH_PATH: /corez
{% endif %}
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      # deploy.yml's drain flag (deploy/caddy/assemble.sh)
      - {{ core_drain_dir }}:/drain:ro
      - caddydata:/data
      - caddyconfig:/config
    ports:
      - "{{ sa_public_bind_ipv4 | default(sa_public_ipv4) }}:80:80"
      - "{{ sa_public_bind_ipv4 | default(sa_public_ipv4) }}:443:443"
      - "{{ sa_public_bind_ipv4 | default(sa_public_ipv4) }}:443:443/udp"
{% if sa_public_ipv6 %}
      - "[{{ sa_public_ipv6 }}]:80:80"
      - "[{{ sa_public_ipv6 }}]:443:443"
      - "[{{ sa_public_ipv6 }}]:443:443/udp"
{% endif %}
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2019/config/"]
      interval: 10s
      timeout: 3s
      retries: 6
{% if core_oauth_fixture %}

  # TEST-ONLY github oauth stand-in for the local converge (asserted above)
  oauth-fixture:
    <<: *defaults
    image: {{ core_oauth_fixture_image }}
    command:
      - -listen=0.0.0.0:8099
      - -client-id=local-converge-fixture-client
      - -client-secret=local-converge-fixture-secret
      - -redirect-url=https://{{ sa_hostnames.app }}/api/auth/github/callback
    ports:
      - "{{ sa_public_ipv4 }}:{{ core_oauth_fixture_port }}:8099"
{% endif %}

volumes:
{% if core_runs_postgres %}
  pgdata:
  pgrun:
{% endif %}
  caddydata:
  caddyconfig:
