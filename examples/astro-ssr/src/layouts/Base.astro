---
import { trackerTag } from "../tracker.ts";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- docs:start head -->
    <Fragment set:html={trackerTag()} />
    <!-- docs:end head -->
  </head>
  <body>
    <nav>
      <a href="/" id="nav-home">Home</a>
      <a href="/about" id="nav-about">About</a>
      <a href="/docs/getting-started" id="nav-docs">Docs</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
