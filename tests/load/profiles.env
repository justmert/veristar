# load profiles of the design. expected peak: web 50 events per second and
# api 116 requests per second, ten times the rfp's daily average of about
# 1,000,000 api requests a day (11.6 per second). the drills run at ten
# times the expected peak.
LOAD_WEB_PEAK=50
LOAD_API_PEAK=116
# the drills run at LOAD_FACTOR times the expected peak (default 10). a
# smaller factor is a different drill and is reported as such
LOAD_FACTOR="${LOAD_FACTOR:-10}"
LOAD_WEB_RATE=$((LOAD_WEB_PEAK * LOAD_FACTOR))
LOAD_API_RATE=$((LOAD_API_PEAK * LOAD_FACTOR))
# pass bounds of the load profile (the design, verification)
LOAD_GATEWAY_P99_MS=250
LOAD_COLLECTOR_P99_MS=500
LOAD_DRAIN_SECONDS=600
