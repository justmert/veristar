# local working files: notes, and the output of test runs, drills and
# local converges (.scratch)
resources/
.scratch

# javascript
node_modules/
dist/
build/
coverage/
!internal/coverage/
.pnpm-store/
*.tsbuildinfo
# generated by react-router typegen, astro sync, sveltekit, next.js,
# docusaurus and vitepress
.react-router/
.astro/
.svelte-kit/
.next/
.docusaurus/
.vitepress/cache/
next-env.d.ts

# test output
playwright-report/
test-results/

# go build output
/bin/

# environment files (the example file is meant to be committed)
.env
.env.*
!.env.example

# opentofu state and working directories. terraform.tfvars holds the
# operator's own addresses, keys and account names; each env tracks a
# terraform.tfvars.example instead
infra/tofu/envs/*/terraform.tfvars
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log

# age private keys
*.agekey
keys.txt

# logs
*.log

# os and editor files
.DS_Store
.claude/

# opentofu plan files (encrypted, but local to one run) and the generated
# ansible inventory (rewritten from state by make <env>-inventory)
tfplan
infra/ansible/inventories/*/hosts.json
infra/ansible/inventories/*/hosts.json.tmp
infra/ansible/inventories/*/hosts.json.pre-*

# the local converge's generated secrets (encrypted to a throwaway key under
# .scratch), never a real environment's
infra/secrets/local/
packages/tracker/npm/

# build outputs and python caches never belong in git
__pycache__/
*.pyc
*.whl
/controlplane
/sloreport
/gateway
/replayer
/jobs
/platformctl
/prober
/metricswriter
/adoptionreport
/issueage
/collector/scf-otelcol
