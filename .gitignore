# internal notes, plan and scratch files
.scratch/

# javascript
node_modules/
dist/
build/
coverage/
.pnpm-store/
*.tsbuildinfo
# generated by react-router typegen, astro sync, sveltekit and next.js
.react-router/
.astro/
.svelte-kit/
.next/
next-env.d.ts

# test output
playwright-report/
test-results/

# go build output
/bin/

# environment files (the example file is meant to be committed)
.env
.env.*
!.env.example

# opentofu state and working directories
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log

# age private keys
*.agekey
keys.txt

# logs
*.log

# os and editor files
.DS_Store

# opentofu plan files (encrypted, but local to one run) and the generated
# ansible inventory (rewritten from state by make <env>-inventory)
tfplan
infra/ansible/inventories/*/hosts.json
infra/ansible/inventories/*/hosts.json.tmp

# the local converge's generated secrets (encrypted to a throwaway key under
# .scratch/scratch), never a real environment's
infra/secrets/local/
packages/tracker/npm/

