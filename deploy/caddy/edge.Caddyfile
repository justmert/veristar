# edge tier caddy (the design, this stage).
#
# environment, all required; each one is used where caddy refuses an empty
# value, so a missing variable fails `caddy validate` and startup:
#   BASE_DOMAIN        registered domain, an operator input; the site is in.<BASE_DOMAIN>
#   GATEWAY_UPSTREAM   host:port of the local gateway on the private side
#   EDGE_TLS           first argument of the tls directive: the acme account
#                      email in production, "internal" for the local ca in tests.
#                      this stage replaces it with dns-01 through caddy-dns/cloudflare,
#                      which needs the custom caddy build.
#
#   COLLECTOR_GRPC_UPSTREAM    host:port of the collector's otlp grpc listener
#   COLLECTOR_HTTP_UPSTREAM    host:port of the collector's otlp http listener
#   COLLECTOR_HEALTH_UPSTREAM  host:port of the collector's health_check
#                              endpoint (this stage, otlp.<BASE_DOMAIN>)

(edge_log_fields) {
	request>remote_ip delete
	request>remote_port delete
	request>client_ip delete
	request>headers delete
	resp_headers delete
}

{
	# a request for a host this file does not serve is logged by caddy's
	# default logger, not by the site log below, and was written unfiltered.
	# it gets the same filter, so no request leaves an address or user agent
	# in any log.
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				import edge_log_fields
			}
		}
	}
}

(edge_log) {
	# access logs keep no client identifier: the remote address and the
	# address caddy derives from it are deleted before the entry is written
	#, and so are all request headers. they hold the user
	# agent, the forwarding headers (a proxy on the visitor's side can put the
	# visitor's real address in x-forwarded-for, x-real-ip or forwarded), the
	# otlp bearer token, and Referer: a tenant page with
	# Referrer-Policy: unsafe-url sends its full url, query included, with
	# every tracker request, and that copy never passes the gateway's
	# sanitizer. response headers go as well, as on web and app.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				import edge_log_fields
			}
		}
	}
}

in.{$BASE_DOMAIN} {
	# caddy replaces an unset variable with nothing. this line needs a value,
	# so a missing BASE_DOMAIN stops caddy instead of serving the bare "in."
	vars base_domain {$BASE_DOMAIN}
	tls {$EDGE_TLS}
	import edge_log

	# the event route is the hot path: one request per page view or event,
	# up to thousands a second per node. its access log line (json encoding
	# through the filter, a write, docker's log copy) cost about a quarter of
	# caddy's cpu in the profile of 2026-11-14
	# (docs/reference/gateway-limits.md, "capacity"), and it holds nothing
	# the gateway's own counters and caddy's metrics do not. so it is not
	# logged at all; the challenge route, the tracker files and every
	# refusal path of other routes still are, filtered as above
	@event {
		method POST
		path /v1/e
	}
	log_skip @event

	reverse_proxy {
		to {$GATEWAY_UPSTREAM}
		# keep enough idle connections to the gateway for every request in
		# flight. with caddy's default of 32 idle connections per host, a
		# burst with more requests in flight closed the extra connections
		# after each answer and opened new ones for the next, so the node
		# spent its cpu on tcp setup and teardown exactly when it was busiest
		# (persistConn.close in the profile of 2026-11-14,
		# docs/reference/gateway-limits.md, "capacity")
		transport http {
			# below the gateway's 60 s idle timeout (internal/obs/server.go), so
			# caddy never reuses a connection the gateway is closing
			keepalive 50s
			keepalive_idle_conns 1024
			keepalive_idle_conns_per_host 1024
		}
		# the gateway reads the client address from this one header only.
		# set replaces whatever a client sent under the same name, and caddy
		# trusts no proxy in front of it, so client_ip is the tcp peer.
		header_up X-Edge-Client-Ip {client_ip}
		# the gateway refuses the common proxy headers as address sources;
		# not sending them keeps the address in exactly one place
		header_up -X-Forwarded-For
		header_up -X-Real-Ip
		header_up -Forwarded
	}
}

# otlp.<BASE_DOMAIN>: otlp grpc and otlp http on 443,
# both to the local collector on the private side, with the same log filter.
#
# the http proxy health-checks the collector's health_check endpoint every
# second. the collector reports ready only once its token snapshot is
# loaded, so while it starts caddy answers 503 (no healthy upstream) or 502
# (port not open yet), which otlp sdks retry, instead of letting the
# collector answer 401, which they do not.
(collector_health) {
	health_upstream {$COLLECTOR_HEALTH_UPSTREAM}
	health_uri /
	health_status 200
	health_interval 1s
	health_timeout 1s
	health_fails 1
	health_passes 1
}

otlp.{$BASE_DOMAIN} {
	tls {$EDGE_TLS}
	import edge_log

	# grpc is http/2 with content type application/grpc. caddy speaks
	# cleartext http/2 (h2c) to the collector's grpc listener. no active
	# health check here: caddy would send it over the same h2c transport,
	# and the collector's health_check endpoint speaks only http/1.1. it is
	# not needed for the startup window either: the collector opens its grpc
	# port only after the token snapshot is loaded, so until then caddy gets
	# a refused connection and answers 502, which grpc clients see as
	# Unavailable and retry.
	@grpc header Content-Type application/grpc*
	handle @grpc {
		reverse_proxy {
			to {$COLLECTOR_GRPC_UPSTREAM}
			transport http {
				versions h2c
			}
			# the collector never needs the client address
			header_up -X-Forwarded-For
			header_up -X-Real-Ip
			header_up -Forwarded
		}
	}

	# otlp http: the three signal paths, post only. the collector checks the
	# body size again after decompression; this bounds the bytes on the wire.
	@otlphttp {
		method POST
		path /v1/metrics /v1/traces /v1/logs
	}
	handle @otlphttp {
		request_body {
			max_size 4MB
		}
		reverse_proxy {
			to {$COLLECTOR_HTTP_UPSTREAM}
			import collector_health
			header_up -X-Forwarded-For
			header_up -X-Real-Ip
			header_up -Forwarded
		}
	}

	handle {
		respond 404
	}
}
